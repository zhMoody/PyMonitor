<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- ===================================================================== -->
  <!-- App Core Identity - 应用核心标识 -->
  <!-- ===================================================================== -->
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundlePackageType</key>
  <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleHumanReadableCopyright</key>
  <string>Copyright (c) 2025 Your Name. All rights reserved.</string>

  <!-- ===================================================================== -->
  <!-- Menu Bar App Behavior - 菜单栏应用行为 -->
  <!-- ===================================================================== -->
  <key>LSUIElement</key>
  <true/>

  <!-- ===================================================================== -->
  <!-- Privacy - Sensitive Permissions - 隐私与敏感权限 -->
  <!-- ===================================================================== -->

  <!-- Hardware Access - 硬件访问 -->
  <key>NSMicrophoneUsageDescription</key>
  <string>PyMonitor 需要访问麦克风，以便其运行的脚本能够录制音频。</string>
  <key>NSCameraUsageDescription</key>
  <string>PyMonitor 需要访问摄像头，以便其运行的脚本能够拍摄照片或录制视频。</string>

  <!-- Screen & Input Control - 屏幕与输入控制 -->
  <key>NSAccessibilityUsageDescription</key>
  <string>PyMonitor 需要获取辅助功能权限，以便其运行的脚本能够模拟键盘输入和鼠标点击，实现自动化操作。</string>
  <key>NSInputMonitoringUsageDescription</key>
  <string>PyMonitor 需要监听键盘输入事件，以便其运行的脚本能够响应全局快捷键或记录按键。</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>PyMonitor 需要访问屏幕内容，以便其运行的脚本能够进行屏幕录制或截图。</string>

  <!-- File System Access - 文件系统访问 -->
  <key>NSDesktopFolderUsageDescription</key>
  <string>PyMonitor 需要访问“桌面”文件夹，以便其运行的脚本能够读取或写入文件。</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>PyMonitor 需要访问“文稿”文件夹，以便其运行的脚本能够读取或写入文件。</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>PyMonitor 需要访问“下载”文件夹，以便其运行的脚本能够读取或写入文件。</string>

</dict>
</plist>
